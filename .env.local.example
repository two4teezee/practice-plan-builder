# Supabase Configuration
# Copy this file to .env.local and fill in your Supabase credentials

# Your Supabase project URL (found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase anon/public key (found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Google Places API Configuration
# Used for location autocomplete in practice plans
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Enable the "Places API" and "Places API (New)" in your Google Cloud project
GOOGLE_PLACES_API_KEY=your-google-places-api-key-here
